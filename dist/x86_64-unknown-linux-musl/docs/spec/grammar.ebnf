(* AXON 1.0 EBNF. INDENT, DEDENT, and NEWLINE are produced by the lexer. *)

module              = { module_item } EOF ;
module_item         = { annotation NEWLINE } ( use_decl | const_decl | fn_decl
                    | struct_decl | enum_decl | trait_decl | impl_block
                    | extern_block ) { NEWLINE } ;

annotation          = "@" lower_ident [ call_args ] ;
use_decl            = "use" module_path [ "." "{" import_list "}" ] NEWLINE ;
module_path         = type_ident { "." type_ident | "." lower_ident } ;
import_list         = import_item { "," import_item } [ "," ] ;
import_item         = lower_ident | type_ident | const_ident ;

const_decl          = "const" const_ident ":" type "=" expr NEWLINE ;

fn_decl             = "fn" lower_ident generic_params? fn_params
                      [ "->" return_type ] fn_body ;
fn_body             = "=" expr NEWLINE | NEWLINE INDENT stmt_block DEDENT ;
return_type         = type | named_tuple_type | "void" | "never" ;
fn_params           = "(" [ fn_param_list ] ")" ;
fn_param_list       = fn_param { "," fn_param } [ "," ] ;
fn_param            = [ "mut" ] lower_ident ":" ( "..." type | type )
                      [ "=" expr ] ;
generic_params      = "(" type_param { "," type_param } [ "," ] ")" ;
type_param          = type_ident [ ":" trait_bound ] ;
trait_bound         = type_path { "+" type_path } ;

struct_decl         = "struct" type_ident generic_params? NEWLINE
                      INDENT { struct_field NEWLINE } DEDENT ;
struct_field        = { annotation NEWLINE } lower_ident ":" type [ "=" expr ] ;

enum_decl           = "enum" type_ident generic_params? NEWLINE
                      INDENT enum_variant { NEWLINE enum_variant } [ NEWLINE ] DEDENT ;
enum_variant        = type_ident [ enum_payload ] ;
enum_payload        = tuple_type | record_literal_fields ;

trait_decl          = "trait" type_ident generic_params? NEWLINE
                      INDENT { trait_item } DEDENT ;
trait_item          = associated_type_decl | fn_signature [ fn_body ] ;
associated_type_decl = "type" type_ident [ ":" trait_bound ] NEWLINE ;
fn_signature        = "fn" lower_ident generic_params? fn_params
                      [ "->" return_type ] where_clause? ;

impl_block          = "impl" generic_params? type [ "as" type_path ]
                      where_clause? NEWLINE INDENT { impl_item } DEDENT ;
impl_item           = { annotation NEWLINE } fn_decl ;

extern_block        = "extern" string_lit NEWLINE INDENT { extern_item } DEDENT ;
extern_item         = { annotation NEWLINE } fn_signature NEWLINE ;

where_clause        = "where" where_bound { "," where_bound } [ "," ] ;
where_bound         = type_ident ":" trait_bound ;

stmt_block          = { stmt } ;
stmt                = simple_stmt NEWLINE | compound_stmt ;
simple_stmt         = let_stmt | assign_stmt | return_stmt | break_stmt
                    | continue_stmt | defer_stmt | expr_stmt ;
let_stmt            = "let" [ "mut" ] pattern [ ":" type ] "=" expr ;
assign_stmt         = assign_target assign_op expr ;
assign_target       = postfix_expr ;
assign_op           = "=" | "+=" | "-=" | "*=" | "/=" | "%=" | "&=" | "|="
                    | "^=" | "<<=" | ">>=" ;
return_stmt         = "return" [ expr_list ] ;
break_stmt          = "break" [ expr ] ;
continue_stmt       = "continue" ;
defer_stmt          = "defer" expr ;
expr_stmt           = expr ;

compound_stmt       = if_stmt | match_stmt | loop_stmt | while_stmt | for_stmt
                    | with_stmt | unsafe_stmt | task_group_stmt ;
if_stmt             = "if" expr "then" block
                      { "else" "if" expr "then" block }
                      [ "else" block ] ;
match_stmt          = "match" expr NEWLINE INDENT match_case { match_case } DEDENT ;
match_case          = "case" pattern [ "if" expr ] "then" block ;
loop_stmt           = "loop" "do" block ;
while_stmt          = "while" expr "do" block ;
for_stmt            = "for" pattern [ "," pattern ] "in" expr "do" block ;
with_stmt           = "with" expr "do" block ;
unsafe_stmt         = "unsafe" "do" block ;
task_group_stmt     = "task_group" "do" block ;
block               = NEWLINE INDENT stmt_block DEDENT | simple_stmt NEWLINE ;

expr_list           = expr { "," expr } [ "," ] ;
expr                = lambda_expr ;
lambda_expr         = "fn" fn_params [ "->" type ] "=" expr
                    | capture_clause "fn" fn_params [ "->" type ] "=" expr
                    | lower_ident "=>" expr
                    | "(" [ lambda_param { "," lambda_param } ] ")" "=>" expr
                    | if_expr ;
lambda_param        = lower_ident [ ":" type ] ;
capture_clause      = "capture" "(" lower_ident { "," lower_ident } [ "," ] ")" ;
if_expr             = "if" expr "then" expr "else" expr | match_expr ;
match_expr          = "match" expr NEWLINE INDENT match_case { match_case } DEDENT
                    | try_expr ;
try_expr            = "try" expr [ "catch" lower_ident "then" expr | "or" expr ]
                    | pipe_expr ;
pipe_expr           = range_expr { "|>" range_expr } ;
range_expr          = logical_or_expr [ ( ".." | "..=" ) [ logical_or_expr ] ] ;
logical_or_expr     = logical_and_expr { "or" logical_and_expr } ;
logical_and_expr    = comparison_expr { "and" comparison_expr } ;
comparison_expr     = bit_or_expr { comparison_op bit_or_expr } ;
comparison_op       = "==" | "!=" | "<" | "<=" | ">" | ">=" | "is" | "is not" ;
bit_or_expr         = bit_xor_expr { "|" bit_xor_expr } ;
bit_xor_expr        = bit_and_expr { "^" bit_and_expr } ;
bit_and_expr        = shift_expr { "&" shift_expr } ;
shift_expr          = additive_expr { ( "<<" | ">>" ) additive_expr } ;
additive_expr       = multiplicative_expr { ( "+" | "-" ) multiplicative_expr } ;
multiplicative_expr = unary_expr { ( "*" | "/" | "%" ) unary_expr } ;
unary_expr          = ( "not" | "-" | "+" | "~" | "*" | "&" | "&mut" ) unary_expr
                    | postfix_expr ;
postfix_expr        = primary_expr { postfix_suffix } ;
postfix_suffix      = call_args | "." lower_ident [ call_args ] | "." integer_lit
                    | "?." lower_ident [ call_args ] | index_suffix | slice_suffix ;
call_args           = "(" [ call_arg_list ] ")" ;
call_arg_list       = call_arg { "," call_arg } [ "," ] ;
call_arg            = [ lower_ident ":" ] expr ;
index_suffix        = "[" expr "]" ;
slice_suffix        = "[" [ expr ] ( ".." | "..=" ) [ expr ] "]" ;

primary_expr        = literal | lower_ident | const_ident | type_path
                    | tuple_expr | array_expr | map_expr | record_expr
                    | task_expr | select_expr | "(" expr ")" ;
task_expr           = "task" "do" block ;
select_expr         = "select" "do" NEWLINE INDENT select_case { select_case } DEDENT ;
select_case         = "case" ( lower_ident "=" expr | expr ) "then" block ;
tuple_expr          = "(" expr "," [ expr_list ] ")" ;
array_expr          = "[" [ expr_list ] "]" | "[" expr ";" expr "]" ;
map_expr            = "{" [ map_entry { "," map_entry } [ "," ] ] "}" ;
map_entry           = expr ":" expr ;
record_expr         = type_path "{" [ record_field { "," record_field } [ "," ] ] "}" ;
record_literal_fields = "{" [ record_type_field { "," record_type_field } [ "," ] ] "}" ;
record_field        = lower_ident ":" expr ;
record_type_field   = lower_ident ":" type ;

pattern             = or_pattern ;
or_pattern          = guardless_pattern { "|" guardless_pattern } ;
guardless_pattern   = "_" | literal | lower_ident | const_ident | range_pattern
                    | tuple_pattern | struct_pattern | enum_pattern ;
range_pattern       = literal ".." literal ;
tuple_pattern       = "(" pattern "," [ pattern { "," pattern } [ "," ] ] ")" ;
struct_pattern      = type_path "{" [ struct_pattern_field
                      { "," struct_pattern_field } [ "," ] ] "}" ;
struct_pattern_field = lower_ident [ ":" pattern ] ;
enum_pattern        = type_path [ "(" [ pattern { "," pattern } [ "," ] ] ")" ] ;

type                = result_type ;
result_type         = optional_type [ "!" type ] ;
optional_type       = primary_type [ "?" ] ;
primary_type        = type_path | tuple_type | array_type | slice_type
                    | ref_type | raw_ptr_type | dyn_type | fn_type ;
type_path           = type_ident { "." type_ident | "." lower_ident }
                      [ "(" type { "," type } [ "," ] ")" ] ;
tuple_type          = "(" type "," type { "," type } [ "," ] ")" ;
named_tuple_type    = "(" lower_ident ":" type "," lower_ident ":" type
                      { "," lower_ident ":" type } [ "," ] ")" ;
array_type          = "[" type ";" expr "]" ;
slice_type          = "[" type "]" ;
ref_type            = "ref" type | "mut" "ref" type ;
raw_ptr_type        = "*" type | "*" "mut" type ;
dyn_type            = "dyn" type_path ;
fn_type             = "fn" "(" [ type { "," type } [ "," ] ] ")" "->" type ;

literal             = integer_lit | float_lit | string_lit | raw_string_lit
                    | format_string_lit | multiline_string_lit | char_lit
                    | "true" | "false" | "none" ;

lower_ident         = XID_START_LOWER { XID_CONTINUE | "_" } ;
type_ident          = XID_START_UPPER { XID_CONTINUE | "_" } ;
const_ident         = UPPER_OR_UNDERSCORE { UPPER_OR_DIGIT_OR_UNDERSCORE } ;
integer_lit         = DIGIT { DIGIT | "_" }
                    | "0x" HEX { HEX | "_" }
                    | "0b" BIT { BIT | "_" }
                    | "0o" OCT { OCT | "_" } ;
float_lit           = DIGIT { DIGIT | "_" } "." DIGIT { DIGIT | "_" }
                      [ EXPONENT ] ;
string_lit          = '"' { string_char | escape } '"' ;
raw_string_lit      = 'r"' { raw_char } '"' ;
format_string_lit   = 'f"' { format_char | "{" expr "}" } '"' ;
multiline_string_lit = '"""' { any_char } '"""' ;
char_lit            = "'" ( string_char | escape ) "'" ;
