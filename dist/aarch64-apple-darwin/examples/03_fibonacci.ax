use Core

fn fib_recursive(n: uint64) -> uint64
    if n < 2 then
        return n
    return fib_recursive(n - 1) + fib_recursive(n - 2)

fn fib_iterative(n: uint64) -> uint64
    let mut a = 0_u64
    let mut b = 1_u64

    for _ in 0..n do
        let next = a + b
        a = b
        b = next

    return a

fn main() -> int
    println(f"recursive: {fib_recursive(10)}")
    println(f"iterative: {fib_iterative(10)}")
    return 0
